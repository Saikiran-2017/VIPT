# Copied to `.env` / `.env.local` for `npm run build` / `npm run dev` in `extension/`.
# Values must match backend: same secret as `API_KEY` in `backend/.env`.

# Full base URL including /api/v1 (no trailing slash before path segments; trailing slash on origin is OK).
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Same value as backend `API_KEY` (sent as X-API-Key on every request).
# For `docker compose`, match `docker-compose.yml` backend `API_KEY`.
VITE_API_KEY=change-me-local-dev-only
